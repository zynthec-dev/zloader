      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere dieses Zertifikatsprofil auf dem Zielgerät und aktiviere das volle Vertrauen unter Einstellungen → Allgemein → Info → Zertifikatsvertrauenseinstellungen. Teile es nur mit vertrauenswürdigen Geräten und entferne das Profil, wenn du es nicht mehr benötigst."
          }
        },
        "en" : {
          "stringUnit" : {
