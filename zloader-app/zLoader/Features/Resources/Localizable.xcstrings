    "Your Apple ID is used to configure apps so they can be installed on this device. Your credentials will be stored securely in this device's Keychain and sent only to Apple for authentication." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Apple-ID wird zur Konfiguration von Apps verwendet, damit sie auf diesem Gerät installiert werden können. Deine Zugangsdaten werden sicher im Schlüsselbund dieses Geräts gespeichert und zur Authentifizierung nur an Apple gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple ID is used to configure apps so they can be installed on this device. Your credentials will be stored securely in this device's Keychain and sent only to Apple for authentication."
          }
        }
      }
    },
    "Your device is not yet registered under this developer team. Apps cannot be installed or refreshed until registration is completed. You can complete this later in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gerät ist in diesem Entwicklerteam noch nicht registriert. Apps können erst nach der Registrierung installiert oder aktualisiert werden. Du kannst dies später in den Einstellungen erledigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device is not yet registered under this developer team. Apps cannot be installed or refreshed until registration is completed. You can complete this later in Settings."
          }
        }
      }
    },
