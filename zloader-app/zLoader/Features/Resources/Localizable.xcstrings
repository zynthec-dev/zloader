          }
        }
      }
    },
    "WireGuard runs the VPN in its own app. zLoader provides the local loopback peer while running; no integrated VPN extension is included." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WireGuard betreibt das VPN in seiner eigenen App. zLoader stellt während der Ausführung die lokale Gegenstelle bereit; eine integrierte VPN-Erweiterung ist nicht enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WireGuard runs the VPN in its own app. zLoader provides the local loopback peer while running; no integrated VPN extension is included."
          }
        }
      }
