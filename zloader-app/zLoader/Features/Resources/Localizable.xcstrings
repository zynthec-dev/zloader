    "An external local VPN tunnel is required for pairing, installation and refresh. Enable a compatible tunnel in your preferred VPN app. This status checks the device service at the tunnel IP; you can continue even when it is not reachable yet." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Pairing, Installation und Refresh wird ein externer lokaler VPN-Tunnel benötigt. Aktiviere einen kompatiblen Tunnel in deiner VPN-App. Dieser Status prüft den Gerätedienst an der Tunnel-IP. Du kannst auch fortfahren, wenn er noch nicht erreichbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An external local VPN tunnel is required for pairing, installation and refresh. Enable a compatible tunnel in your preferred VPN app. This status checks the device service at the tunnel IP; you can continue even when it is not reachable yet."
          }
        }
      }
    },
