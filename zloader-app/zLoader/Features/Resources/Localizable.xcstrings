    "This changes the selected resources on Apple's servers. Certificates and dependent installations may become unusable. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ändert die ausgewählten Ressourcen auf Apples Servern. Zertifikate und damit signierte Installationen können unbrauchbar werden. Dies lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "This deletes this stored key and CSR. It does not revoke an Apple certificate or remove copies already attached to signing certificates." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht den gespeicherten Schlüssel und die CSR. Ein Apple-Zertifikat wird nicht widerrufen, und bereits zugeordnete Schlüsselkopien bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
