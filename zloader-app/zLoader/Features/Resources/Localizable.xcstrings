    },
    "zLoader can use local network access to discover Bonjour (mDNS) services on your network. This is not required for core functionality." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zLoader kann Bonjour-Dienste (mDNS) im lokalen Netzwerk finden. Für die Grundfunktionen ist dies nicht erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zLoader can use local network access to discover Bonjour (mDNS) services on your network. This is not required for core functionality."
          }
        }
      }
    },
    "zLoader cannot manage the existing certificate without owning its private key. The apps signed with the existing certificate will expire soon unless they are resigned and renewed explicitly by zLoader." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zLoader kann das vorhandene Zertifikat ohne dessen privaten Schlüssel nicht verwalten. Damit signierte Apps laufen bald ab, wenn sie nicht ausdrücklich mit zLoader neu signiert und erneuert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zLoader cannot manage the existing certificate without owning its private key. The apps signed with the existing certificate will expire soon unless they are resigned and renewed explicitly by zLoader."
          }
        }
      }
    },
    "zLoader communicates with on-device services over a local loopback VPN. Enable External Local VPN Tunnel before verifying." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zLoader kommuniziert über einen lokalen Loopback-VPN-Tunnel mit Gerätediensten. Aktiviere vor der Prüfung deinen externen lokalen VPN-Tunnel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zLoader communicates with on-device services over a local loopback VPN. Enable External Local VPN Tunnel before verifying."
