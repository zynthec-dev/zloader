    "Choose the VPN on this iPhone. Create personal automations in Shortcuts; zLoader does not install them automatically. Cancelling or terminating a shortcut can prevent its disconnect step." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das VPN auf diesem iPhone. Erstelle persönliche Automationen in Kurzbefehle; zLoader installiert sie nicht automatisch. Wird ein Kurzbefehl abgebrochen oder beendet, kann sein Trennschritt ausbleiben."
          }
        },
        "en" : {
