    "Pair another device on your local network. Select a network interface to advertise, or connect to a discovered target. Pairing files for other devices are exported without replacing zLoader’s own pairing files." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paire ein anderes Gerät im lokalen Netzwerk. Wähle eine Schnittstelle zum Anbieten des Dienstes oder verbinde dich mit einem entdeckten Ziel. Pairing-Dateien anderer Geräte werden exportiert, ohne die eigenen Dateien von zLoader zu ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pair another device on your local network. Select a network interface to advertise, or connect to a discovered target. Pairing files for other devices are exported without replacing zLoader’s own pairing files."
          }
        }
      }
    },
