      }
    },
    "Start Pairing opens Settings when the server is ready. Go to Privacy & Security → Developer Mode. The PIN appears in the Live Activity and, with your permission, a notification. After pairing, tap the notification or Live Activity to return to zLoader." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pairing starten“ öffnet die Einstellungen, sobald der Server bereit ist. Gehe zu Datenschutz & Sicherheit → Entwicklermodus. Die PIN erscheint in der Live-Aktivität und mit deiner Erlaubnis auch als Mitteilung. Tippe nach dem Pairing auf die Mitteilung oder Live-Aktivität, um zu zLoader zurückzukehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start Pairing opens Settings when the server is ready. Go to Privacy & Security → Developer Mode. The PIN appears in the Live Activity and, with your permission, a notification. After pairing, tap the notification or Live Activity to return to zLoader."
          }
        }
      }
    },
    "Start Pairing starts the server and shows instructions. Open Settings manually to finish pairing. The PIN appears in the Live Activity and, with your permission, a notification." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Pairing starten“ startet den Server und zeigt eine Anleitung. Öffne die Einstellungen manuell, um das Pairing abzuschließen. Die PIN erscheint in der Live-Aktivität und, mit deiner Erlaubnis, in einer Mitteilung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start Pairing starts the server and shows instructions. Open Settings manually to finish pairing. The PIN appears in the Live Activity and, with your permission, a notification."
          }
        }
      }
    },
